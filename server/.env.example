# Copy to .env (never commit .env) and fill in the token.

# Token shared with the extension (options page → "Token de acesso"), at least 16 characters.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
KMOVERLAY_TOKEN=

# Address the server listens on. 127.0.0.1 = only this computer.
# Use 0.0.0.0 to reach it from the phone, and list below the names the phone uses.
KMOVERLAY_HOST=127.0.0.1
KMOVERLAY_PORT=8000

# Extra Host names accepted, comma separated (e.g. 192.168.0.10,pc.tailnet.ts.net).
KMOVERLAY_ALLOWED_HOSTS=

# Simulated processing time of the demonstration pipeline, in milliseconds.
KMOVERLAY_DEMO_DELAY_MS=800
